    // =============================================
    // PURCHASE REQUESTS - Connected to Supply Department
    // These functions handle purchase request data from the supply department
    // =============================================

    // Get all purchase requests from supply department (updated for new schema)
    static async getAllPurchaseRequests() {
        const SQL_COMMAND = `
            SELECT 
                pr.pr_id,
                pr.requested_by,
                pr.supplier_id,
                sa.supplier_name,
                pr.material_id,
                m.name AS material_name,
                pr.variant,
                pr.quantity_requested,
                pr.unit,
                pr.unit_price,
                pr.total_price,
                pr.created_date,
                pr.status,
                u.username AS requested_by_name,
                DATE_FORMAT(pr.created_date, '%Y-%m-%d %H:%i:%s') as created_date_formatted
            FROM purchase_requests pr
            LEFT JOIN supplier_account sa ON pr.supplier_id = sa.supplier_id
            LEFT JOIN materials m ON pr.material_id = m.material_id
            LEFT JOIN users u ON pr.requested_by = u.id
            WHERE pr.status != 'Cancelled'
            ORDER BY 
                CASE 
                    WHEN pr.status = 'Pending' THEN 1
                    WHEN pr.status = 'Finance Approved' THEN 2
                    WHEN pr.status = 'Finance Rejected' THEN 3
                    WHEN pr.status = 'Converted to PO' THEN 4
                    ELSE 5
                END,
                pr.created_date DESC;
        `;

        try {
            console.log('Executing SQL query for purchase requests (new schema)...');
            console.log('SQL Command:', SQL_COMMAND);
            
            const [requests] = await db.query(SQL_COMMAND);
            console.log('Number of purchase requests found:', requests.length);
            if (requests.length > 0) {
                console.log('Sample purchase request:', requests[0]);
            } else {
                console.log('No purchase requests found in the database');
            }
            return requests;
        } catch (error) {
            console.error('Detailed error in getAllPurchaseRequests:', {
                message: error.message,
                code: error.code,
                sqlMessage: error.sqlMessage,
                sqlState: error.sqlState,
                sql: error.sql
            });
            throw new Error(`Failed to fetch purchase requests: ${error.message}`);
        }
    }

    // List purchases that have supplier-provided delivery cost/discount and are pending finance approval
    static async getPendingPurchaseEstimations() {
        const SQL = `
            SELECT 
                p.purchase_id,
                p.pr_id,
                p.supplier_id,
                sa.supplier_name,
                p.material_id,
                m.name AS material_name,
                p.variant,
                CAST(p.quantity AS DECIMAL(10,2)) AS quantity,
                p.unit,
                CAST(p.unit_price AS DECIMAL(10,2)) AS unit_price,
                COALESCE(p.delivery_cost, 0) AS delivery_cost,
                COALESCE(p.discount, 0) AS discount_percent,
                DATE_FORMAT(p.created_date, '%Y-%m-%d %H:%i:%s') AS created_date
            FROM purchases p
            LEFT JOIN supplier_account sa ON sa.supplier_id = p.supplier_id
            LEFT JOIN materials m ON m.material_id = p.material_id
            WHERE p.status = 'Pending' AND (COALESCE(p.delivery_cost,0) > 0 OR COALESCE(p.discount,0) > 0)
            ORDER BY p.created_date DESC
        `;
        try {
            const [rows] = await db.query(SQL);
            return rows.map(r => {
                const subtotal = Number(r.quantity) * Number(r.unit_price);
                const discountAmount = subtotal * (Number(r.discount_percent) / 100);
                const final_total = subtotal - discountAmount + Number(r.delivery_cost);
                return {
                    ...r,
                    subtotal: Number(subtotal.toFixed(2)),
                    discount_amount: Number(discountAmount.toFixed(2)),
                    final_total: Number(final_total.toFixed(2))
                };
            });
        } catch (err) {
            console.error('Error in getPendingPurchaseEstimations:', err);
            throw new Error('Failed to fetch pending purchase estimations');
        }
    }

    // Approve a supplier estimation: set purchase status to 'Processed'
    static async approvePurchaseEstimation(purchaseId) {
        try {
            // Compute final total and persist as invoice_amount when approving
            const [rows] = await db.query(`
                SELECT quantity, unit, unit_price, COALESCE(delivery_cost,0) AS delivery_cost, COALESCE(discount,0) AS discount
                FROM purchases WHERE purchase_id = ? AND status = 'Pending'
            `, [purchaseId]);
            if (!rows || rows.length === 0) {
                return { success: false, message: 'Purchase not found or not in Pending status' };
            }
            const r = rows[0];
            const subtotal = Number(r.quantity) * Number(r.unit_price);
            const discountAmount = subtotal * (Number(r.discount) / 100);
            const finalTotal = subtotal - discountAmount + Number(r.delivery_cost);

            const [res] = await db.query(
                `UPDATE purchases SET status = 'Processed', invoice_amount = ? WHERE purchase_id = ? AND status = 'Pending'`,
                [finalTotal, purchaseId]
            );
            if (res.affectedRows === 0) {
                return { success: false, message: 'Purchase not found or not in Pending status' };
            }
            return { success: true };
        } catch (err) {
            console.error('Error in approvePurchaseEstimation:', err);
            throw new Error('Failed to approve purchase estimation');
        }
    }

    // Update purchase request status (for finance approval/rejection) - updated for new schema
    static async updatePurchaseRequestStatus(requestId, status, remarks = null) {
        const connection = await db.getConnection();
        try {
            await connection.beginTransaction();

            // If approving, create purchase order
            if (status === 'Finance Approved') {
                // Get the purchase request details
                const [requestRows] = await connection.query(`
                    SELECT 
                        pr_id, supplier_id, material_id, variant, 
                        quantity_requested, unit, unit_price, total_price
                    FROM purchase_requests 
                    WHERE pr_id = ? AND status = 'Pending'
                `, [requestId]);

                if (requestRows.length === 0) {
                    await connection.rollback();
                    throw new Error('Purchase request not found or already processed');
                }

                const request = requestRows[0];

                // Update the purchase request status
                await connection.query(`
                    UPDATE purchase_requests 
                    SET status = ?
                    WHERE pr_id = ?
                `, [status, requestId]);

                // Insert into purchases table (Purchase Order for supplier)
                await connection.query(`
                    INSERT INTO purchases (
                        pr_id, supplier_id, material_id, variant, 
                        quantity, unit, unit_price, 
                        status, created_date
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, 'Pending', NOW())
                `, [
                    request.pr_id,
                    request.supplier_id,
                    request.material_id,
                    request.variant,
                    request.quantity_requested,
                    request.unit,
                    request.unit_price
                ]);
            } else {
                // For other status updates (rejection, etc.)
                const [result] = await connection.query(`
                    UPDATE purchase_requests 
                    SET status = ?
                    WHERE pr_id = ?
                `, [status, requestId]);

                if (result.affectedRows === 0) {
                    await connection.rollback();
                    throw new Error('Purchase request not found');
                }
            }

            await connection.commit();
            return true;
        } catch (error) {
            await connection.rollback();
            console.error('Error in updatePurchaseRequestStatus:', error);
            throw new Error('Failed to update purchase request status');
        } finally {
            connection.release();
        }
    }

    // Update purchase request status to approved (for finance approval) - updated for new schema
    static async approvePurchaseRequest(requestId) {
        const connection = await db.getConnection();
        try {
            await connection.beginTransaction();

            // First, get the purchase request details
            const [requestRows] = await connection.query(`
                SELECT 
                    pr_id, supplier_id, material_id, variant, 
                    quantity_requested, unit, unit_price, total_price
                FROM purchase_requests 
                WHERE pr_id = ? AND status = 'Pending'
            `, [requestId]);

            if (requestRows.length === 0) {
                await connection.rollback();
                throw new Error('Purchase request not found or already processed');
            }

            const request = requestRows[0];

            // Update the purchase request status to Finance Approved
            await connection.query(`
                UPDATE purchase_requests 
                SET status = 'Finance Approved'
                WHERE pr_id = ?
            `, [requestId]);

            // Insert into purchases table (Purchase Order for supplier)
            const [purchaseResult] = await connection.query(`
                INSERT INTO purchases (
                    pr_id, supplier_id, material_id, variant, 
                    quantity, unit, unit_price, 
                    status, created_date
                ) VALUES (?, ?, ?, ?, ?, ?, ?, 'Pending', NOW())
            `, [
                request.pr_id,
                request.supplier_id,
                request.material_id,
                request.variant,
                request.quantity_requested,
                request.unit,
                request.unit_price
            ]);

            await connection.commit();

            return {
                success: true,
                message: 'Purchase request approved successfully and purchase order created',
                purchase_id: purchaseResult.insertId
            };
        } catch (error) {
            await connection.rollback();
            console.error('Error in approvePurchaseRequest:', error);
            throw new Error('Failed to approve purchase request: ' + error.message);
        } finally {
            connection.release();
        }
    }

